<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#080C14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="36dp">

        <!-- Top Bar: Title & History Button (Apple iOS Style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Apple Dynamic Status Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_badge_lang"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginBottom="8dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_green"
                        android:layout_marginEnd="7dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ONLINE • READY"
                        android:textColor="#34D399"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Call Subtitles • DE ➔ RU"
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Apple Glass History Button -->
            <Button
                android:id="@+id/btn_open_history"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="📜 История"
                android:textSize="12sp"
                android:textColor="#38BDF8"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_btn_secondary_glass"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <!-- 1. Card: Accessibility Intercept Service (Shield) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1E293B"
            app:cardBackgroundColor="#0F172A"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_bubble_blue"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🛡️"
                            android:textSize="18sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Перехват звука звонка"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#F8FAFC" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Приоритет Android 10–15"
                            android:textSize="11sp"
                            android:textColor="#64748B" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_acc_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VOICE_REC"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#38BDF8"
                        android:background="@drawable/bg_badge_lang"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_acc_service_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Служба специальных возможностей необходима, чтобы система не глушила микрофон во время разговора по телефону."
                    android:textSize="13sp"
                    android:textColor="#94A3B8"
                    android:lineSpacingMultiplier="1.25"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btn_enable_acc_service"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="⚙️ Включить в настройках"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="@drawable/bg_btn_gradient_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Card: Google Gemini AI Key -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1E293B"
            app:cardBackgroundColor="#0F172A"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_bubble_indigo"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🔑"
                            android:textSize="18sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Google AI Studio Key"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#F8FAFC" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Модель: gemini-3.5-flash-lite"
                            android:textSize="11sp"
                            android:textColor="#64748B" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_api_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_api_key"
                    app:boxBackgroundColor="#090E17"
                    app:boxStrokeColor="#38BDF8"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:hintTextColor="#38BDF8"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#64748B">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_api_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#475569"
                        android:inputType="textPassword"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btn_save_key"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/btn_save_key"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="@drawable/bg_btn_secondary_glass"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tv_key_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_key_not_saved"
                    android:textSize="12sp"
                    android:textColor="#EF4444"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Card: Express Mic & AI Diagnostic -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1E293B"
            app:cardBackgroundColor="#0F172A"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_bubble_amber"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🎙️"
                            android:textSize="18sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Экспресс-тест (3 сек)"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#F8FAFC" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Проверка захвата речи и Gemini AI"
                            android:textSize="11sp"
                            android:textColor="#64748B" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_mic_test_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Нажмите кнопку и произнесите фразу на немецком (например: «Guten Tag»). Приложение запишет 3 секунды и покажет перевод."
                    android:textSize="13sp"
                    android:textColor="#94A3B8"
                    android:lineSpacingMultiplier="1.25"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btn_run_mic_test"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="⚡ Начать экспресс-тест"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="@drawable/bg_btn_gradient_amber" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Card: Manual Overlay Launch (WhatsApp / Telegram calls) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1E293B"
            app:cardBackgroundColor="#0F172A"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icon_bubble_emerald"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="💬"
                            android:textSize="18sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ручной запуск субтитров"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#F8FAFC" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Для WhatsApp, Telegram или проверки"
                            android:textSize="11sp"
                            android:textColor="#64748B" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Запускает плавающий оверлей субтитров без обычного телефонного звонка."
                    android:textSize="13sp"
                    android:textColor="#94A3B8"
                    android:lineSpacingMultiplier="1.25"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btn_toggle_service"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/btn_start_test"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:background="@drawable/bg_btn_gradient_emerald" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bottom Guide Action -->
        <Button
            android:id="@+id/btn_reopen_onboarding"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="#38BDF8"
            android:text="💡 Инструкция по звонкам в Германии"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
