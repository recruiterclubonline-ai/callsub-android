<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_overlay_rounded"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="14dp"
    android:layout_margin="10dp"
    android:elevation="16dp">

    <!-- Ручка перетаскивания (Drag Handle) -->
    <View
        android:id="@+id/drag_handle"
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_drag_handle"
        android:layout_marginBottom="8dp" />

    <!-- Верхняя панель: Статус + Язык + Немецкий оригинал + Кнопки настроек -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Цветной кружок статуса: зеленый/желтый/красный -->
        <View
            android:id="@+id/status_indicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/circle_green"
            android:layout_marginEnd="6dp" />

        <!-- Иконка динамика/микрофона -->
        <TextView
            android:id="@+id/tv_speaker_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊"
            android:textSize="14sp"
            android:layout_marginEnd="6dp" />

        <!-- Бейдж направления перевода -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DE → RU"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_lang"
            android:layout_marginEnd="8dp" />

        <!-- Исходная немецкая речь -->
        <TextView
            android:id="@+id/tv_german"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_german"
            android:textSize="13sp"
            android:textStyle="italic"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Warte auf deutsche Sprache..." />

        <!-- Кнопка размера шрифта (Pill) -->
        <TextView
            android:id="@+id/btn_font_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Аа"
            android:textColor="@color/accent_yellow"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_pill"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Кнопка свернуть/развернуть -->
        <TextView
            android:id="@+id/btn_minimize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/text_german"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_pill"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Основной блок синхронного перевода на русский (крупный, яркий, легко читаемый на бегу) -->
    <TextView
        android:id="@+id/tv_russian"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_russian"
        android:textSize="20sp"
        android:textStyle="bold"
        android:lineSpacingMultiplier="1.2"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="3"
        android:maxLines="4"
        android:text="Слушаю немецкую речь собеседника..." />

    <!-- Нижняя панель быстрых действий с тактильными кнопками -->
    <LinearLayout
        android:id="@+id/panel_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <!-- Кнопка фразы "Да, точно" (Ja, genau) -->
        <TextView
            android:id="@+id/btn_ja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ Ja"
            android:textColor="@color/accent_yellow"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_pill"
            android:clickable="true"
            android:focusable="true" />

        <!-- Кнопка фразы "Einen Moment" -->
        <TextView
            android:id="@+id/btn_moment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏸ Moment"
            android:textColor="@color/accent_yellow"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_pill"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Кнопка фразы "Langsamer bitte" -->
        <TextView
            android:id="@+id/btn_langsamer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊 Langsamer"
            android:textColor="@color/accent_yellow"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_pill"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
